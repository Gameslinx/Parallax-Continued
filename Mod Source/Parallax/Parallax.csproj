<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <Platforms>AnyCPU;x86;x64</Platforms>
        <AssemblyName>ParallaxContinued</AssemblyName>
        <LangVersion>13</LangVersion>
        <NoWarn>0169</NoWarn>
        <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>TRACE;DEBUG;ENABLE_PROFILER</DefineConstants>
    </PropertyGroup>

    <!-- KSPBuildTools -->
    <PropertyGroup>
        <!-- KSPBT_GameRoot is only resolved in KSPBuildTools.targets, so KSPBT_ModRoot is set from the
             KSPBT_UseGameModRoot target below. Set KSPBT_InstallToGame to false to output into
             Mod Source/GameData instead. -->
        <KSPBT_InstallToGame Condition="'$(KSPBT_InstallToGame)' == ''">true</KSPBT_InstallToGame>
        <KSPBT_ModRoot>$(MSBuildProjectDirectory)/../GameData/ParallaxContinued</KSPBT_ModRoot>
        <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>

        <!-- The assembly attributes are declared manually in ConfigLoader.cs -->
        <KSPBT_GenerateAssemblyAttribute>false</KSPBT_GenerateAssemblyAttribute>
        <KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
        <KSPBT_GenerateVersionFile>false</KSPBT_GenerateVersionFile>

        <!-- Dependencies are expected to be installed already. Set this to true to have them installed with CKAN. -->
        <KSPBT_InstallCKANDependencies>false</KSPBT_InstallCKANDependencies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KSPBuildTools" Version="1.1.1" />
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ModReference Include="0Harmony">
            <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
            <CKANIdentifier>Harmony2</CKANIdentifier>
        </ModReference>
        <ModReference Include="Kopernicus">
            <DLLPath>GameData/Kopernicus/Plugins/Kopernicus.dll</DLLPath>
            <CKANIdentifier>Kopernicus</CKANIdentifier>
        </ModReference>
        <ModReference Include="Kopernicus.Parser">
            <DLLPath>GameData/Kopernicus/Plugins/Kopernicus.Parser.dll</DLLPath>
        </ModReference>
        <ModReference Include="KSPBurst">
            <DLLPath>GameData/000_KSPBurst/Plugins/KSPBurst.dll</DLLPath>
            <CKANIdentifier>KSPBurst</CKANIdentifier>
        </ModReference>
        <ModReference Include="KSPTextureLoader">
            <DLLPath>GameData/KSPTextureLoader/Plugins/KSPTextureLoader.dll</DLLPath>
            <CKANIdentifier>KSPTextureLoader</CKANIdentifier>
        </ModReference>
        <ModReference Include="Microsoft.Extensions.FileSystemGlobbing">
            <DLLPath>GameData/000_KSPBurst/Plugins/Microsoft.Extensions.FileSystemGlobbing.dll</DLLPath>
        </ModReference>
        <ModReference Include="System.Runtime.CompilerServices.Unsafe">
            <DLLPath>GameData/000_KSPBurst/Plugins/System.Runtime.CompilerServices.Unsafe.dll</DLLPath>
        </ModReference>
        <ModReference Include="Unity.Burst">
            <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Burst.dll</DLLPath>
        </ModReference>
        <ModReference Include="Unity.Burst.Unsafe">
            <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Burst.Unsafe.dll</DLLPath>
        </ModReference>
        <ModReference Include="Unity.Collections">
            <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Collections.dll</DLLPath>
        </ModReference>
        <ModReference Include="Unity.Jobs">
            <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Jobs.dll</DLLPath>
        </ModReference>
        <ModReference Include="Unity.Mathematics">
            <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Mathematics.dll</DLLPath>
        </ModReference>
    </ItemGroup>

    <ItemGroup>
      <!-- Publicizer-->
      <!-- PQS -->
      <Publicize Include="Assembly-CSharp:PQ.PrecisePosition" />
      <Publicize Include="Assembly-CSharp:PQS.cache" />
      <Publicize Include="Assembly-CSharp:PQS.gameObject" />
      <Publicize Include="Assembly-CSharp:PQS.vbData" />
      <Publicize Include="Assembly-CSharp:PQS.targetPositionPrev" />
      <Publicize Include="Assembly-CSharp:PQS.pqID" />
      <Publicize Include="Assembly-CSharp:PQS.fixedUpdateFrame" />
      <Publicize Include="Assembly-CSharp:PQS.maxLevel1" />
      <Publicize Include="Assembly-CSharp:PQS.itr" />
      <Publicize Include="Assembly-CSharp:PQS.mods" />

      <Publicize Include="Assembly-CSharp:PQS.SetupMods" />
      <Publicize Include="Assembly-CSharp:PQS.SetupBuildDelegates" />
      <Publicize Include="Assembly-CSharp:PQS.Mod_OnSphereStart" />
      <Publicize Include="Assembly-CSharp:PQS.UpdateVisual" />
      <Publicize Include="Assembly-CSharp:PQS.UpdateQuadsInit" />
      <Publicize Include="Assembly-CSharp:PQS.Mod_OnPostSetup" />
      <Publicize Include="Assembly-CSharp:PQS.Mod_OnSphereStarted" />
      <Publicize Include="Assembly-CSharp:PQS.StartSphere" />
      <Publicize Include="Assembly-CSharp:PQS.UpdateSphere" />

      <Publicize Include="UnityEngine.CoreModule:UnityEngine.Rendering.AsyncGPUReadbackRequest.GetDataRaw" />
      
      <Publicize Include="Kopernicus:Kopernicus.ShadowMan.ShadowRemoveFadeCommandBuffer.m_Buffer" />
      <Publicize Include="Kopernicus:Kopernicus.ShadowMan.ShadowRemoveFadeCommandBuffer.m_Camera" />

      <Publicize Include="Assembly-CSharp:Sun.scaledSunLight" />

      <Publicize Include="Assembly-CSharp:MapSO.Byte2Float" />
      <Publicize Include="Assembly-CSharp:MapSO._data" />
      <Publicize Include="Assembly-CSharp:MapSO.PixelIndex" />
      <Publicize Include="Assembly-CSharp" MemberPattern="^MapSO\..*" />
    </ItemGroup>

    <Target Name="KSPBT_UseGameModRoot" BeforeTargets="KSPBT_CopyDLLsToPluginFolder" Condition="'$(KSPBT_InstallToGame)' == 'true'">
        <PropertyGroup>
            <KSPBT_ModRoot>$(KSPBT_GameRoot)/GameData/ParallaxContinued</KSPBT_ModRoot>
        </PropertyGroup>
    </Target>

</Project>
